# Nagar Kuraiteer — Environment Configuration
# Copy to .env and fill in values for your deployment.

# Gemini API key (leave empty to run in deterministic offline mock mode)
GEMINI_API_KEY=

# LLM execution mode: auto | mock | live
LLM_MODE=auto

# Application environment: development | production
# In production, demo OTP codes are omitted from API responses.
APP_ENV=development

# Database connection string (SQLite default; supports PostgreSQL URLs)
DB_URL=sqlite:///./nagar_kuraiteer.db

# Maximum clarifying questions before forcing confirmation card
QUESTION_BUDGET=3

# Pilot city branding and tracking ID prefix
CITY_NAME=Coimbatore
CITY_CODE=CBE

# Comma-separated allowed CORS origins (never use * in production)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional shared secret header (X-Admin-Key) to protect /api/v1/admin/* endpoints
# Leave empty for open local demo mode; set a strong random string in production.
ADMIN_API_KEY=

# Demo OTP code (development/testing only)
MOCK_OTP=123456
